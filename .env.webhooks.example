# ============================================================================
#  CONFIGURACIÓN DE WEBHOOKS
# ============================================================================

# Habilitar/deshabilitar servidor de webhooks
WEBHOOKS_ENABLED=true

# Dirección en la que escucha el servidor
# 0.0.0.0 = escucha en todas las interfaces (recomendado en producción)
# 127.0.0.1 = solo localhost (testing)
WEBHOOK_HOST=0.0.0.0

# Puerto del servidor webhook
WEBHOOK_PORT=5000

# Secreto para validar webhooks (si rss.app lo proporciona)
# Dejar vacío si no usas validación
WEBHOOK_SECRET=

# Mantener polling como fallback (si hay problemas con webhooks)
WEBHOOKS_WITH_POLLING_FALLBACK=true

# ============================================================================
#  CONFIGURACIÓN RSS (como antes)
# ============================================================================

# Usar RSS en lugar de Facebook Scraper
USE_RSS_FEED=true

# Credenciales RSS API
RSS_API_KEY=c_7aE06O3k7WkZ0S
RSS_API_SECRET=s_wrrdXjFLUPmdULTkqJ1FfJ

# ============================================================================
#  CONFIGURACIÓN DE IA
# ============================================================================

# Proveedor de IA: "openai", "claude", "gemini", "groq", "openrouter"
AI_PROVIDER=openai

# Claves de API (según proveedor)
OPENAI_API_KEY=sk-...
# CLAUDE_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# ============================================================================
#  CONFIGURACIÓN DE BASE DE DATOS (Opcional)
# ============================================================================

# PostgreSQL o SQLite para deduplicación persistente
# DATABASE_URL=postgresql://user:password@localhost/alertas
# DATABASE_URL=sqlite:///alertas.db

# ============================================================================
#  CONFIGURACIÓN DE GOOGLE SHEETS (Opcional)
# ============================================================================

# Tabla de Google Sheets para registrar alertas
# GOOGLE_SHEETS_ID=tu_sheets_id

# ============================================================================
#  CONFIGURACIÓN DE HEALTHCHECKS (Opcional)
# ============================================================================

# Ping a healthchecks.io o UptimeRobot
# HEARTBEAT_URL=https://uptime.healthchecks.io/ping/...
