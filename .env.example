# ─────────────────────────────────────────────────────────
# .env.example — Sistema de Alertas Protecta Perú
# Copiar a ".env" y completar con los valores reales.
# NO subir el ".env" real a git (ya está en .gitignore).
# ─────────────────────────────────────────────────────────
# Google Sheets
SPREADSHEET_ID=

# Base de datos (PostgreSQL / Neon)
DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require


# IA Provider
AI_PROVIDER=openai
OPENAI_API_KEY=

# WhatsApp
WHATSAPP_PROVIDER=bridge
BRIDGE_URL=http://localhost:3000
BRIDGE_TOKEN=

# Acortador de links propio (Cloudflare Worker) — ver cloudflare-shortener/README.md
# Si se dejan vacios, se usa clck.ru/da.gd/is.gd como respaldo.
SHORTENER_URL=
SHORTENER_TOKEN=


# Sheets
SHEETS_ENABLED=true

FB_EMAIL=
FB_PASSWORD=


# Habilitar/deshabilitar servidor de webhooks
WEBHOOKS_ENABLED=false

# Dirección en la que escucha el servidor
# 0.0.0.0 = escucha en todas las interfaces (recomendado en producción)
# 127.0.0.1 = solo localhost (testing)
WEBHOOK_HOST=0.0.0.0

# Puerto del servidor webhook
WEBHOOK_PORT=5000

# Secreto para validar webhooks (si rss.app lo proporciona)
# Dejar vacío si no usas validación
WEBHOOK_SECRET=

# Mantener polling como fallback (si hay problemas con webhooks)
WEBHOOKS_WITH_POLLING_FALLBACK=false


RSS_API_KEY=
RSS_API_SECRET=
